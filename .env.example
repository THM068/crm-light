# Local development settings for crm-light.
#
# Copy this to `.env` and it is picked up automatically by `cargo run`:
#
#     cp .env.example .env
#
# `.env` is gitignored, so a password here stays on your machine.
#
# Precedence: the real environment wins over this file, which wins over the
# compiled-in defaults. So `CRM_DB=... cargo run` and the systemd unit's
# EnvironmentFile both override what is written here.

# --- Where the data lives -------------------------------------------------
#
# The compiled-in default, and enough for a local cluster where you connect over
# the unix socket with peer authentication — which is what Homebrew's Postgres
# and a stock Ubuntu install both do by default. If `psql crm_light` works
# without a password, this works too.
#
# If your cluster wants a password over TCP, either create the role with
# deploy/provision-db.sh and write the URL it prints:
#
#     ./deploy/provision-db.sh --out .env
#
# or write it by hand:
#
#     CRM_DB=postgresql://USER:PASSWORD@127.0.0.1:5432/crm_light?sslmode=disable
CRM_DB=postgresql://localhost/crm_light

# --- Cookies and sessions -------------------------------------------------
#
# Optional locally. Without it a random key is generated per process and every
# restart signs you out, which is only an annoyance in development.
#CRM_SECRET_KEY=

# Leave at 0 for plain HTTP on localhost. Set to 1 only behind TLS: with it on
# and no TLS, the browser accepts the session cookie and refuses to send it
# back, so sign-in silently fails.
CRM_COOKIE_SECURE=0

# --- Who can get in -------------------------------------------------------
#
# On locally so you can create a workspace. Turn it off if you are testing what
# a deployed installation looks like.
CRM_ALLOW_SIGNUP=1

# --- Presentation ---------------------------------------------------------
#
# Unset means the host's zone. Storage is always UTC; this only affects display.
#CRM_TZ=Europe/London
CRM_PAGE_SIZE=25

# --- First-run behaviour --------------------------------------------------
#
# The demo book is inserted into the first workspace you create, so the pages
# have something to look at. Set to 1 to skip it.
CRM_SEED=0

# --- Where it listens -----------------------------------------------------
#
# `topcoat dev` and `cargo run` both read these. Change PORT if 3000 is taken.
HOST=127.0.0.1
PORT=3000

# --- Notes on syntax ------------------------------------------------------
#
# Values are taken literally — no shell expansion, no command substitution. A
# `$` or a backtick in a password does nothing surprising.
#
# The one rule worth knowing: in an *unquoted* value, ` #` starts a comment. If
# a password contains " #", put the whole value in quotes:
#
#     CRM_DB="postgresql://u:pass #word@localhost/db"
